# Anthropic API key. Use a key created inside a workspace; for an organisation-level
# key, also set ANTHROPIC_WORKSPACE_ID.
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=

# HubSpot service key for the DEMO account only (never a production CRM).
# Scopes: crm.objects.{companies,contacts,deals}.{read,write}
HUBSPOT_SERVICE_KEY=
